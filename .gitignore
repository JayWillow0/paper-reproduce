# macOS and editors
.DS_Store
._*
.idea/
.vscode/
*.swp

# Python
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/

# Generated caches and local model weights
**/cache/
**/*.npz
**/*.pt
**/*.pth
**/*.ckpt

# Upstream repositories and raw data are fetched locally
**/repo/
**/data/
**/data

# PEMFC experiment run data (bulky per-run outputs);
# exp_* configs, entry scripts and reference data stay tracked
AE-pemfc-paper/experiments/exp_*/runs/

# Copyrighted paper PDFs must never enter the repository
**/*.pdf

# Temporary files
**/tmp/
**/*.tmp
**/*.bak

# Local agent session artifacts
.zcode/
.zcodeignore

.env/
